# 認証情報
client_secret.json
token.json
# 認証情報のバックアップ。2026-08-19 の自動コミットが
# client_secret.json.bgm-shared.bak / token.json.bgm-shared.bak を拾い、
# GitHub のシークレット保護に push を止められた（中身は本物の OAuth 情報）。
# 拡張子を足しただけの名前が上の2行をすり抜けるので、パターンで塞ぐ。
*.bak
client_secret.json.*
token.json.*
.env
# 別名のコピーが .gitignore をすり抜けて自動コミットに載った
# （2026-08-19: token.json.bgm-shared.bak / client_secret.json.bgm-shared.bak）
*.bak
client_secret.json.*
token.json.*

# 中間生成物（再取得できるものは持たない）
work/
*.mp4
*.wav

run_daily*.log
run_long.log

__pycache__/
*.pyc
.venv/
*.bak

# TikTok の認証情報（client_secret.json / token.json と同じ扱い）
tiktok_client.json
tiktok_token.json
tiktok_client.json.*
tiktok_token.json.*
tiktok.log
